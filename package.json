{
  "name": "fyp-web-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "analytics": "arch -arm64 ric-api/.venv/bin/python ric-api/generate_analytics.py",
    "analytics:csv": "arch -arm64 ric-api/.venv/bin/python ric-api/generate_analytics.py --input-csv",
    "analytics:open": "cd ric-api && latest=$(ls -1 analytics_output | sort | tail -n 1) && open \"analytics_output/$latest/index.html\"",
    "analytics:run-open": "pnpm run analytics && pnpm run analytics:open"
  },
  "dependencies": {
    "expo-camera": "^57.0.3",
    "next": "16.2.10",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-native": "^0.86.0",
    "sonner": "^2.0.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
